# Application Configuration
APP_NAME="Smart Room Light & Energy Management Backend"
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security & Authentication
SECRET_KEY="super-secret-jwt-key-replace-in-production-fpga-iot-2026"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (SQLite default; PostgreSQL-ready)
DATABASE_URL="sqlite:///./smart_room_system.db"

# Hardware / Communication Gateway
SERIAL_PORT="COM3"
BAUD_RATE=115200
ENABLE_HARDWARE_SERIAL=False # Set to True when physical ESP32/FPGA is attached to COM port
ENABLE_SIMULATION_FALLBACK=True # Automatically runs physical emulator if hardware is not attached
DEFAULT_DEVICE_ID="ROOM_001"
